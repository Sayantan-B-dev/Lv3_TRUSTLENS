# ─────────────────────────────────────────────────────────────────────────────
# TrustLens environment template. Copy to .env and adjust locally.
# NEVER commit .env or real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Database — SQLite works with zero setup. Production uses PostgreSQL/Neon:
# DATABASE_URL=postgresql+psycopg://trustlens:password@localhost:5432/trustlens
# DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+pysqlite:///./trustlens.db
# DIRECT_DATABASE_URL is used by Alembic in production (Neon direct host).
DIRECT_DATABASE_URL=
AUTO_CREATE_SCHEMA=true

# Sessions — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-session-secret-change-me
COOKIE_SECURE=false
SESSION_DAYS=30
ANONYMOUS_ACCESS_ENABLED=true

# Optional Google OAuth (no passwords are stored).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud Console. The Next.js proxy keeps the cookie
# on the browser-visible host in production too.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Retention
ANONYMOUS_RETENTION_DAYS=7
USER_RETENTION_DAYS=90

# Worker
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=180
JOB_MAX_ATTEMPTS=4
JOB_RETRY_BASE_SECONDS=15

# Rate limiting (per instance)
RATE_LIMIT_PER_MINUTE=30
GENERAL_RATE_LIMIT_PER_MINUTE=240

# Safe fetching
FETCH_TIMEOUT_SECONDS=8
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_MAX_BYTES=65536
FETCH_MAX_REDIRECTS=5
ALLOWED_PORTS=80,443
MAX_INPUT_CHARS=20000

# Threat intelligence (no key required for URLhaus)
THREAT_INTEL_ENABLED=true
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/url/
URLHAUS_AUTH_KEY=
CT_LOOKUP_ENABLED=true

# AI — optional. Without a key the deterministic explainer is used.
# AI_PROVIDER=auto | none | mock | openai
AI_PROVIDER=auto
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Web3 report registry (local Hardhat only by default)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_CONTRACT_ADDRESS=
# Well-known Hardhat account #0 key for LOCAL chains only. Never fund or reuse.
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAIN_EXPLORER_BASE=
